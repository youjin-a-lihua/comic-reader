# 环境变量示例（复制为 .env 后按需修改）
# cp .env.example .env

# 对外端口
PORT=3000

# JWT 密钥：留空则首次启动自动生成并写入数据卷的 .jwt-secret（重启不失效）
# 想固定密钥可在此填一个 >=32 字符的随机串
JWT_SECRET=

# 在线源：默认不开启（留空即可）。
# 需要在线漫画时，设置为 jm（禁漫天堂）或自建源名，并重启服务。
# 可用源通过 lib/sources/ 注册，开启后所需的其它环境变量见对应源文件注释。
ONLINE_SOURCE=

# 可选：小说目录绝对路径（不设则不显示「小说」库）
NOVEL_DIR=
